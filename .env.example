# Copiez ce fichier en « .env » puis remplissez-le, ou laissez faire : ./scripts/init-env.sh app.mondomaine.fr
# Ne partagez jamais votre fichier .env et ne l'ajoutez jamais à Git.

# Nom de domaine du site, sans https:// (l'enregistrement A doit pointer vers ce serveur).
DOMAIN=app.mondomaine.fr

# Mot de passe de la base de données (lettres, chiffres, - et _ uniquement).
POSTGRES_PASSWORD=

# Clé de chiffrement des secrets stockés en base (session Telegram, clé API, token du bot).
# 44 caractères. Génération : openssl rand -base64 32 | tr '+/' '-_'
# IMPORTANT : conservez-en une copie. Si elle change, il faudra reconnecter Telegram et ressaisir les clés.
FERNET_KEY=

# Secret partagé entre le site et le service Telegram. Génération : openssl rand -hex 32
INTERNAL_TOKEN=

# Code demandé une seule fois, à la création du compte administrateur. Génération : openssl rand -hex 8
SETUP_TOKEN=

# Fuseau horaire des statistiques et des sauvegardes.
TZ=Europe/Paris

# Nombre de jours de sauvegardes conservés dans ./backups.
BACKUP_KEEP_DAYS=14

# Taille maximale d'un fichier de pack, en Mo (facultatif, 500 par défaut).
# MAX_UPLOAD_MB=500
